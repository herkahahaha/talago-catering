{
  "name": "catering-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @catering/api dev",
    "dev:web": "pnpm --filter @catering/web dev",
    "dev:dashboard": "pnpm --filter @catering/dashboard dev",
    "dev:worker": "pnpm --filter @catering/api dev:worker",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && node scripts/check-boundaries.mjs",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @catering/core test:integration",
    "db:generate": "pnpm --filter @catering/core db:generate",
    "db:migrate": "pnpm --filter @catering/core db:migrate",
    "db:seed": "pnpm --filter @catering/core db:seed",
    "db:reset": "pnpm --filter @catering/core db:reset",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:dev:up": "docker compose -f deploy/compose.dev.yml up -d --build",
    "docker:dev:logs": "docker compose -f deploy/compose.dev.yml logs -f",
    "docker:dev:down": "docker compose -f deploy/compose.dev.yml down",
    "docker:dev:seed": "docker compose --profile seed -f deploy/compose.dev.yml run --rm seed",
    "docker:staging:up": "docker compose --env-file deploy/env/.env.staging -f deploy/compose.staging.yml up -d --build",
    "docker:staging:down": "docker compose --env-file deploy/env/.env.staging -f deploy/compose.staging.yml down",
    "docker:staging:seed": "docker compose --env-file deploy/env/.env.staging --profile seed -f deploy/compose.staging.yml run --rm seed",
    "docker:staging:logs": "docker compose --env-file deploy/env/.env.staging -f deploy/compose.staging.yml logs -f api worker dashboard",
    "docker:prod:up": "docker compose --env-file deploy/env/.env.production -f deploy/compose.prod.yml up -d",
    "docker:prod:down": "docker compose --env-file deploy/env/.env.production -f deploy/compose.prod.yml down",
    "docker:prod:pull": "docker compose --env-file deploy/env/.env.production -f deploy/compose.prod.yml pull",
    "docker:prod:logs": "docker compose --env-file deploy/env/.env.production -f deploy/compose.prod.yml logs -f api worker"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "type": "module"
}
