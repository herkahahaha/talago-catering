---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Sajian Kita — Katering Pontianak',
  description = 'Katering harian, syukuran, dan pesanan kantor di Pontianak. Minimal 50 porsi, pesan H-1 sebelum 18.00 WIB.',
} = Astro.props;

const path = new URL(Astro.request.url).pathname;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#17251d" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='50' fill='%2317251d'/%3E%3Ctext x='50' y='68' font-family='Georgia' font-size='52' fill='%23fbf7ee' text-anchor='middle'%3ESK%3C/text%3E%3C/svg%3E"
    />
  </head>
  <body>
    <Header current={path} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
