---
interface Props {
  current: string;
}
const { current } = Astro.props;
---

<header class="site-header">
  <div class="container inner">
    <a class="brand" href="/" aria-label="Sajian Kita, beranda">
      <span class="brand-mark">SK</span>
      <span class="brand-text">
        <strong>Sajian Kita</strong>
        <small>Katering Pontianak</small>
      </span>
    </a>
    <nav class="nav" aria-label="Navigasi utama">
      <a href="/menu" aria-current={current === '/menu' ? 'page' : undefined}>
        Menu
      </a>
      <a href="/pesanan" aria-current={current === '/pesanan' ? 'page' : undefined}>
        Pesanan
      </a>
      <a href="/#cara-pesan">Cara pesan</a>
      <a href="/quote" aria-current={current === '/quote' ? 'page' : undefined}>
        Pesanan besar
      </a>
      <a href="/#area">Area antar</a>
    </nav>
    <a class="btn btn-primary btn-sm" href="/menu">
      Pesan sekarang
    </a>
  </div>
</header>
