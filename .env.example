# ── Database (PostgreSQL 16) ────────────────────────────────────────────────
DATABASE_URL=postgres://catering:catering_dev_pw@127.0.0.1:5432/catering_dev
DATABASE_URL_TEST=postgres://catering:catering_dev_pw@127.0.0.1:5432/catering_test

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
# web | worker  (satu image, dua peran)
ROLE=web
PORT=3000
TZ=Asia/Jakarta
API_BASE_URL=http://127.0.0.1:3000
APP_URL=http://127.0.0.1:4321
DASHBOARD_URL=http://127.0.0.1:3001

# ── Secrets ────────────────────────────────────────────────────────────────
# 32+ byte random string. Rotasi akan membatalkan sesi tamu & admin.
SESSION_SECRET=dev-session-secret-change-me-please-32b
# Kunci HMAC untuk challenge CAPTCHA (Turnstile bisa dipasang lewat env)
CAPTCHA_SECRET=dev-captcha-secret-change-me-32b
CAPTCHA_PROVIDER=challenge

# ── Payment gateway ────────────────────────────────────────────────────────
PAYMENT_GATEWAY=mock
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
PAYMENT_MOCK_BASE_URL=http://127.0.0.1:3000/api/v1/webhooks/payment

# ── Dashboard seed ─────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@catering.local
ADMIN_PASSWORD=admin12345
