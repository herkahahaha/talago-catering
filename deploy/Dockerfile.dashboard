# syntax=docker/dockerfile:1.7
# Image dashboard internal (TanStack Start + SolidJS, output Nitro).
# VITE_API_URL di-inline saat build — satu build per environment.
# Build: docker build -f deploy/Dockerfile.dashboard --build-arg VITE_API_URL=https://api.example.id -t catering/dashboard:latest .

FROM node:24-alpine AS base
RUN npm install -g pnpm@10.34.9 --no-fund --no-audit
WORKDIR /repo
ENV CI=1

FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
COPY apps/dashboard/package.json apps/dashboard/
COPY packages/contracts/package.json packages/contracts/
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY apps/dashboard apps/dashboard
COPY packages/contracts packages/contracts
ARG VITE_API_URL=http://127.0.0.1:3000
ENV VITE_API_URL=$VITE_API_URL
RUN pnpm --filter @catering/dashboard build

FROM base AS runtime
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3001

COPY --from=build --chown=node:node /repo/apps/dashboard/.output ./.output

USER node
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:${PORT}/login" >/dev/null || exit 1

CMD ["node", ".output/server/index.mjs"]
