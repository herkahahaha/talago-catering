# ── Staging (docker compose -f deploy/compose.staging.yml) ───────────────────
# Salin: cp deploy/env/.env.staging.example deploy/env/.env.staging
# Ganti semua CHANGE_ME. Jangan commit file .env.staging.
NODE_ENV=production
TZ=Asia/Jakarta
LOG_LEVEL=info

# Nama host `db` dipakai bila memakai database dari compose.staging.yml.
DATABASE_URL=postgres://catering:CHANGE_ME_DB_PASSWORD@db:5432/catering_staging
DB_POOL_MAX=20

ROLE=web
PORT=3000
API_BASE_URL=http://api:3000
# URL publik (di-inline saat build web & dashboard).
PUBLIC_API_URL=http://127.0.0.1:3000
APP_URL=http://127.0.0.1:4321
DASHBOARD_URL=http://127.0.0.1:3001

SESSION_SECRET=CHANGE_ME_openssl_rand_base64_48
CAPTCHA_SECRET=CHANGE_ME_openssl_rand_base64_32
CAPTCHA_PROVIDER=challenge
PAYMENT_GATEWAY=mock
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
PAYMENT_MOCK_BASE_URL=http://127.0.0.1:3000/api/v1/webhooks/payment

ADMIN_EMAIL=admin@staging.catering.local
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Hanya dipakai service db staging.
POSTGRES_USER=catering
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=catering_staging

# Tag image & port host.
IMAGE_PREFIX=catering
API_PORT=3000
WEB_PORT=4321
DASHBOARD_PORT=3001
DB_PORT=5434
