# ── Production (docker compose -f deploy/compose.prod.yml) ───────────────────
# Salin: cp deploy/env/.env.production.example deploy/env/.env.production
# File .env.production tidak boleh di-commit. Isi dari secret manager bila ada.
NODE_ENV=production
TZ=Asia/Jakarta
LOG_LEVEL=info

# Database terkelola (disarankan). Contoh:
# postgres://catering:PASSWORD@db.internal:5432/catering?sslmode=require
# Bila memakai Postgres self-hosted, jalankan dengan overlay compose.prod.db.yml
# dan ganti host menjadi `db`.
DATABASE_URL=postgres://catering:CHANGE_ME@db-host:5432/catering?sslmode=require
DB_POOL_MAX=30

ROLE=web
PORT=3000
API_BASE_URL=http://api:3000
PUBLIC_API_URL=https://api.example.id
APP_URL=https://example.id
DASHBOARD_URL=https://dashboard.example.id

SESSION_SECRET=CHANGE_ME_openssl_rand_base64_48
CAPTCHA_SECRET=CHANGE_ME_openssl_rand_base64_32
CAPTCHA_PROVIDER=turnstile
PAYMENT_GATEWAY=midtrans
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
# Diabaikan bila PAYMENT_GATEWAY bukan mock.
PAYMENT_MOCK_BASE_URL=https://api.example.id/api/v1/webhooks/payment

ADMIN_EMAIL=admin@example.id
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Hanya dipakai bila menjalankan overlay compose.prod.db.yml.
POSTGRES_USER=catering
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=catering

# Image yang dipakai compose.
IMAGE_PREFIX=catering
IMAGE_TAG=latest
API_PORT=3000
WEB_PORT=4321
DASHBOARD_PORT=3001
