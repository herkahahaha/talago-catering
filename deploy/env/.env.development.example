# ── Development (docker compose -f deploy/compose.dev.yml) ───────────────────
# Salin: cp deploy/env/.env.development.example deploy/env/.env.development
# File .env.development tidak di-commit.
NODE_ENV=development
TZ=Asia/Jakarta
LOG_LEVEL=debug

# Host `db` adalah nama service di compose. Untuk tools di host gunakan
# postgres://catering:catering_dev_pw@127.0.0.1:5433/catering_dev
DATABASE_URL=postgres://catering:catering_dev_pw@db:5432/catering_dev
DATABASE_URL_TEST=postgres://catering:catering_dev_pw@db:5432/catering_test
DATABASE_URL_HOST=postgres://catering:catering_dev_pw@127.0.0.1:5433/catering_dev
DB_POOL_MAX=10

# API di dalam jaringan compose (SSR -> API, target proxy /api dev, dan fallback SSR).
API_BASE_URL=http://api:3000
# Dibiarkan kosong di development: browser memakai proxy /api se-origin
# (astro.config.mjs / vite.config.ts) agar cookie sesi/staf selalu first-party,
# baik dibuka via localhost maupun 127.0.0.1. Diisi hanya untuk native non-proxy bila perlu.
PUBLIC_API_URL=
APP_URL=http://127.0.0.1:4321
DASHBOARD_URL=http://127.0.0.1:3001
# URL API yang di-inline Vite untuk dashboard (lihat PUBLIC_API_URL di atas).
VITE_API_URL=

SESSION_SECRET=dev-session-secret-change-me-please-32b
CAPTCHA_SECRET=dev-captcha-secret-change-me-32b
CAPTCHA_PROVIDER=challenge
PAYMENT_GATEWAY=mock
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
PAYMENT_MOCK_BASE_URL=http://127.0.0.1:3000/api/v1/webhooks/payment

ADMIN_EMAIL=admin@catering.local
ADMIN_PASSWORD=admin12345

POSTGRES_USER=catering
POSTGRES_PASSWORD=catering_dev_pw
POSTGRES_DB=catering_dev

# Port host (opsional)
API_PORT=3000
WEB_PORT=4321
DASHBOARD_PORT=3001
DB_PORT=5433
